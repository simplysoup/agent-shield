# Copy to .env and supply only the key(s) needed for your chosen workflow.
# Frozen fixtures: defender key only. Development generation: both keys.
GROQ_API_KEY=
OPENAI_API_KEY=

AGENTSHIELD_DEFENDER_PROVIDER=groq
# Set to a model actually enabled on your Groq account.
AGENTSHIELD_DEFENDER_MODEL=openai/gpt-oss-120b
AGENTSHIELD_ATTACKER_MODEL=gpt-6-luna
# GROQ_BASE_URL=https://api.groq.com/openai/v1
